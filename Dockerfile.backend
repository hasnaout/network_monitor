# ============================================================
#  NOVOS — Dockerfile Backend (Django + Daphne)
#  Build : docker build -f Dockerfile.backend -t novos-backend .
# ============================================================

# ── Étape 1 : image de base ──────────────────────────────────
FROM python:3.11-slim

# ── Métadonnées ──────────────────────────────────────────────
LABEL maintainer="Hasna Outaleb"
LABEL project="NOVOS - Novopharma"

# ── Variables d'environnement Python ────────────────────────
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ── Dépendances système (mysqlclient a besoin de gcc + libssl) ──
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        default-libmysqlclient-dev \
        pkg-config \
        libssl-dev \
        netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# ── Répertoire de travail ────────────────────────────────────
WORKDIR /app

# ── Installation des dépendances Python ─────────────────────
COPY requirements.docker.txt .
RUN pip install --upgrade pip \
 && pip install --no-cache-dir -r requirements.docker.txt
# ── Copie du code source ─────────────────────────────────────
COPY . .

# ── Script d'entrée ─────────────────────────────────────────
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

# ── Port exposé ──────────────────────────────────────────────
EXPOSE 8001

# ── Point d'entrée ───────────────────────────────────────────
ENTRYPOINT ["/docker-entrypoint.sh"]
