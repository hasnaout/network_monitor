# ============================================================
#  NOVOS — Dockerfile Frontend (React → Nginx)
#  Build multi-stage : node pour compiler, nginx pour servir
#  Build : docker build -f Dockerfile.frontend -t novos-frontend .
# ============================================================

# ── Étape 1 : Build React ────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copie des fichiers de dépendances en premier (cache Docker)
COPY frontend/package*.json ./
RUN npm ci --silent

# Copie du code source React
COPY frontend/ .

# Variables d'environnement pour le build
ARG REACT_APP_API_URL=""
ARG REACT_APP_WS_URL=""
ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_WS_URL=$REACT_APP_WS_URL

# Build de production
RUN npm run build

# ── Étape 2 : Serveur Nginx ──────────────────────────────────
FROM nginx:1.25-alpine

LABEL maintainer="Hasna Outaleb"
LABEL project="NOVOS - Novopharma"

# Suppression de la config Nginx par défaut
RUN rm /etc/nginx/conf.d/default.conf

# Copie de la configuration Nginx personnalisée
COPY frontend/nginx.conf /etc/nginx/conf.d/novos.conf

# Copie des fichiers buildés depuis l'étape 1
COPY --from=builder /app/build /usr/share/nginx/html

# Port exposé
EXPOSE 80

# Démarrage de Nginx en foreground
CMD ["nginx", "-g", "daemon off;"]
